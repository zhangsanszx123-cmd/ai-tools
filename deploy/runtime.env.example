# Raw Compose env file: no quotes, no interpolation. Never commit runtime.env.
DATABASE_URL=postgresql://ai_tools:URL_ENCODED_PASSWORD@postgresql:5432/ai-tools
# Expected certificate identity; the current database certificate has this IP SAN.
# This keeps CA-chain verification and checks the original IP even on internal DNS.
DB_TLS_IDENTITY=43.143.85.207
BETTER_AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
BETTER_AUTH_URL=https://tools.example.com
