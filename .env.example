# Copy to .env.local. Never commit real credentials.
DATABASE_URL=

# PEM certificate, escaped newlines, or an absolute path to the CA file.
# SSL certificate verification is always enabled.
DB_CA_CERT=

# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Use your actual HTTPS origin in production.
BETTER_AUTH_URL=http://localhost:3000

# Persistent filesystem directory; defaults to <project>/storage/media.
# MEDIA_STORAGE_DIR=/var/lib/ai-tools/media
